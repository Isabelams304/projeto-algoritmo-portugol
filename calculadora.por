programa
{
    funcao inicio()
    {
        inteiro valor1
        inteiro valor2
        inteiro soma

        escreva("Digite o primeiro valor: ")
        leia(valor1)

        escreva("Digite o segundo valor: ")
        leia(valor2)

        soma = valor1 + valor2

        escreva("Resultado da soma: ", soma)
    }
}
